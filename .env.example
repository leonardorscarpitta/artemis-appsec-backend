# Copy to .env for local development. In production these come from secrets.
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://db:5432/artemis
DB_USERNAME=artemis
DB_PASSWORD=change-me

# OpenID Connect issuer (Authelia). Required when AUTH_ENABLED=true.
OIDC_ISSUER_URI=
AUTH_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:4200
