# Copy to .env for local development. In production these come from secrets.
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://db:5432/artemis
DB_USERNAME=artemis
DB_PASSWORD=change-me

# OpenID Connect (Authelia). The issuer must match the "iss" claim; the JWKS URL may be internal.
OIDC_ISSUER_URI=https://auth.artemis.localhost:9443
OIDC_JWK_SET_URI=http://auth-proxy:9080/jwks.json
OIDC_AUDIENCE=artemis-api
# dev profile only: set to false to skip authentication entirely
AUTH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4200
