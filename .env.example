# Copy to .env for local development. In production these come from secrets.
POSTGRES_DB=artemisappsec
POSTGRES_USER=artemisappsec
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://db:5432/artemisappsec
DB_USERNAME=artemisappsec
DB_PASSWORD=change-me

# OpenID Connect (Keycloak realm artemisappsec). The issuer must match the "iss" claim; the JWKS URL may be internal.
OIDC_ISSUER_URI=https://auth.artemisappsec.localhost:9443/realms/artemisappsec
OIDC_JWK_SET_URI=http://keycloak:8080/realms/artemisappsec/protocol/openid-connect/certs
OIDC_AUDIENCE=artemisappsec-api
# dev profile only: set to false to skip authentication entirely
AUTH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Shared secret between the API's internal job endpoints and the scanner runner (min. 32 characters).
# Generate one with: openssl rand -hex 32   (or: python3 -c "import secrets; print(secrets.token_hex(32))")
SCANNER_TOKEN=
# Wall-clock limit for one whole scan run in the runner (all stages and folders); the rest is skipped and the run fails.
SCANNER_RUN_TIMEOUT_SECONDS=3600

# Keycloak (identity provider). Generate strong values, e.g. openssl rand -hex 24
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# User management for Artemis administrators (Keycloak Admin REST API). Secret of the confidential client
# artemisappsec-admin-api (service account with realm-management view-users, query-users, manage-users).
# Set it BEFORE Keycloak's first start (the realm import uses it), min. 32 characters: openssl rand -hex 32.
# For an existing realm, ./keycloak/create-dev-users.sh creates the client and writes the secret here if empty.
# Without it, the admin Users tab answers 503 and the rest of Artemis works.
KEYCLOAK_ADMIN_API_CLIENT_SECRET=
# Internal Keycloak URL (default in docker-compose: http://keycloak:8080); realm and client id have defaults.
# KEYCLOAK_ADMIN_API_URL=http://keycloak:8080
# KEYCLOAK_ADMIN_API_REALM=artemisappsec
# KEYCLOAK_ADMIN_API_CLIENT_ID=artemisappsec-admin-api

# Encrypts the private deploy keys Artemis generates for private (SSH) repositories, with AES-256-GCM.
# Base64 of 32 random bytes: openssl rand -base64 32. Keep it secret and backed up — losing it means every
# private repository needs a new deploy key. Without it, private repositories are disabled.
# The id is stored with each ciphertext (change it when you introduce a new key).
DEPLOY_KEY_ENCRYPTION_KEY=
DEPLOY_KEY_ENCRYPTION_KEY_ID=v1

# AI-written report summaries (Google Gemini API, key from https://aistudio.google.com). Empty = disabled: reports
# use the standard texts. Only organizations with the AI feature granted by an Artemis administrator use it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=30
# AI_REPORTS_PER_DAY=10
